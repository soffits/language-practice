  {
   "id": "fr.greetings.1",
   "title": {
    "zh": "打招呼和说再见",
    "en": "Hello, goodbye, thanks"
   },
   "minutes": 6,
   "explain": {
    "zh": "bonjour 从早上用到傍晚，bonsoir 晚上用；salut 只对熟人，“嗨”和“拜”都能说。对不熟的人说话用 vous 的礼貌说法：s’il vous plaît（请）、excusez-moi（打扰一下 / 不好意思）。加拿大魁北克人也常用 bonjour 来说再见。"
   },
   "items": [
    {
     "id": "1",
     "say": "bonjour",
     "gloss": {
      "zh": "你好"
     },
     "hint": {
      "zh": "早上到傍晚"
     },
     "drill": [
      "hear",
      "say"
     ]
    },
    {
