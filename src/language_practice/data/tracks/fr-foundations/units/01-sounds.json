  {
   "id": "fr.sounds.3",
   "title": {
    "zh": "鼻化元音 an, on, in",
    "en": "Nasal vowels an, on, in"
   },
   "minutes": 7,
   "explain": {
    "zh": "法语有三个鼻化元音：an/en 口型像“啊”（靠后），on 口型像“哦”（嘴圆），in/ain 口型像“诶”（嘴角拉开）。气从鼻子里出来，发完就收：不要在后面加 n 或 ng，嘴也不要闭上。"
   },
   "items": [
    {
     "id": "1",
     "say": "dans",
     "gloss": {
      "zh": "在……里"
     },
